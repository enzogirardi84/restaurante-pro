# COMANDAPRO ERP — Variables de entorno
# Copiar como .env (local) o cargar en Streamlit Cloud Secrets

# ── Motor de base de datos ─────────────────────────
# "sqlite" para desarrollo local
# "postgresql" para Streamlit Cloud / producción
DB_ENGINE=sqlite

# Para PostgreSQL en cloud, usar DATABASE_URL (reemplaza parámetros individuales)
# Formato: postgresql://user:password@host:5432/dbname?sslmode=require
# ⚠️  Si la contraseña tiene @ # % /, debe estar URL-encoded
#    Ej: contraseña "abc@123" → "abc%40123"
