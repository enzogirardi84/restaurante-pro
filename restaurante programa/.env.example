# Copiar a .env para desarrollo local si se conecta Supabase.
# Nunca subir .env con claves reales.
# El sistema funciona con SQLite local por defecto.

DB_ENGINE=postgresql

# Pooler transaccional (puerto 6543) para CRUD diario.
# Reemplazar PROJECT_REF, USER y PASSWORD por valores reales en .env local o Streamlit Secrets.
DATABASE_URL_POOLER=postgresql://USER:PASSWORD@PROJECT_REF.supabase.co:6543/postgres?sslmode=require

# Conexion directa (puerto 5432) para DDL/migraciones.
DATABASE_URL_DIRECTA=postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Fallback (usa la misma pooler).
DATABASE_URL=postgresql://USER:PASSWORD@PROJECT_REF.supabase.co:6543/postgres?sslmode=require

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=NO_PONER_ACA_SOLO_EN_STREAMLIT_CLOUD_SECRETS
