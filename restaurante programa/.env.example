# Copiar a .env para desarrollo local si se conecta Supabase.
# Nunca subir .env con claves reales.
# El sistema funciona con SQLite local por defecto.

DB_ENGINE=postgresql

# Pooler transaccional (puerto 6543) — para CRUD diario
DATABASE_URL_POOLER=postgresql://usuario:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Conexion directa (puerto 5432) — solo para DDL y migraciones
DATABASE_URL_DIRECTA=postgresql://postgres:password@db.proyecto.supabase.co:5432/postgres?sslmode=require

# Fallback si no estan definidas
DATABASE_URL=postgresql://usuario:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

SUPABASE_URL=https://proyecto.supabase.co
SUPABASE_ANON_KEY=anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=service_role_key_aqui
